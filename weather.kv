<WeatherRoot>:
    orientation: 'vertical'
    spacing: dp(8)
    padding: dp(8), dp(8)

    MDTopAppBar:
        title: "Prognoza 7 dni"
        elevation: 6
        right_action_items: [["refresh", lambda x: app.reload()]]
        md_bg_color: 0.15, 0.2, 0.25, 1

    ScrollView:
        do_scroll_x: False
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(12)
            padding: dp(6)

            # === KARTA POWITALNA ===
            MDCard:
                size_hint_y: None
                height: dp(150)
                radius: [20]
                padding: dp(16)
                elevation: 6
                md_bg_color: 0.18, 0.25, 0.35, 1

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(8)
                    MDLabel:
                        text: "🌤️ Witaj w aplikacji pogodowej! Serdecznie zachecamy do uzywania."
                        halign: "center"
                        font_size: "20sp"
                        text_color: 1, 1, 1, 1
                    MDLabel:
                        text: "Sprawdz prognoze na najbliższe 7 dni ponizej."
                        halign: "center"
                        font_size: "14sp"
                        text_color: 0.9, 0.9, 0.9, 1

            # === FUNKCJA DLA KART DNIA ===
            # (powtarzamy 7 razy, bo KivyMD nie wspiera pętli w KV)

            # === Dzień 1 ===
            MDCard:
                size_hint_y: None
                height: dp(230)
                radius: [20]
                padding: dp(12)
                elevation: 4
                md_bg_color: 0.2, 0.3, 0.4, 1

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(6)

                    MDLabel:
                        text: "Dzień 1"
                        halign: "center"
                        font_size: "18sp"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        id: status_label_day1
                        text: "Status: Ładowanie..."
                        halign: "center"
                        font_size: "14sp"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        id: hour_value_day1
                        text: "Godzina: --"
                        halign: "center"
                        font_size: "16sp"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        id: temperature_value_day1
                        text: "Temperatura: -- °C"
                        halign: "center"
                        font_size: "16sp"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        id: rain_value_day1
                        text: "Opady: -- mm"
                        halign: "center"
                        font_size: "16sp"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        id: wind_value_day1
                        text: "Wiatr: -- km/h"
                        halign: "center"
                        font_size: "16sp"
                        text_color: 1, 1, 1, 1


            # === Dzień 2 ===
            MDCard:
                size_hint_y: None
